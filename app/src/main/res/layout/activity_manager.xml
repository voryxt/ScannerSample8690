<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingTop="@dimen/activity_vertical_margin">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:id="@+id/radiogroup_linear_id">

          <LinearLayout
             android:orientation="horizontal"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginRight="5dp"
             android:id="@+id/radiogroup_linear_id1">

              <RadioButton
                  android:id="@+id/BLE_id"
                  android:layout_width="100dp"
                  android:layout_height="wrap_content"
                  android:checked="true"
                  android:text="BLE" />

              <RadioButton
                  android:id="@+id/classic_BT_id"
                  android:layout_width="150dp"
                  android:layout_height="wrap_content"
                  android:checked="false"
                  android:text="Classic BT" />
              <RadioButton
                  android:id="@+id/EZScan_id"
                  android:layout_width="150dp"
                  android:checked="false"
                  android:layout_height="wrap_content"
                  android:text="EZScan" />

    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:id="@+id/radiogroup_linear_id2">
    <Button
        android:id="@+id/scanButton"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:onClick="onScanButtonPressed"
        android:text="@string/scan_button_title" />

    <Button
        android:id="@+id/clearAllButton"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:onClick="onClearAllButtonPressed"
        android:text="@string/clear_all_button_title" />
        <Button
            android:id="@+id/stopButton"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:enabled="false"
            android:onClick="onStopScanButtonPressed"
            android:text="@string/stop_scan_button_title" />

    </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/scanIndicator"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_below="@+id/radiogroup_linear_id"
        android:layout_centerHorizontal="true"
        android:visibility="invisible" />

    <ListView
        android:id="@+id/peripheralsListView"
        android:layout_width="match_parent"
        android:layout_height="534dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="181dp"
        android:layout_marginRight="0dp"
        android:background="#FFFFFF"
        android:dividerHeight="4.0dp" />

    <EditText
        android:id="@+id/editTextMacAddress"
        android:layout_width="231dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/scanIndicator"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="-4dp"
        android:ems="10"
        android:enabled="false"
        android:inputType="textPersonName" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="182dp"
        android:layout_height="50dp"
        android:layout_below="@+id/scanIndicator"
        android:layout_alignParentStart="true"
        android:layout_marginStart="18dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="-16dp"
        android:layout_marginBottom="133dp"
        android:layout_toStartOf="@+id/editTextMacAddress"
        android:text="Scan Mac Address Bar Code" />

</RelativeLayout>
