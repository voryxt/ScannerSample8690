<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/mainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="4dp"
        android:text="@string/main_title_placeholder"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/mainTitle"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text="@string/sub_title_placeholder"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="109dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/subTitle"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="7dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="3dp"
        android:onClick="onConnectButtonPressed"
        android:text="@string/connect_button_title" />

    <Button
        android:id="@+id/disconnectButton"
        android:layout_width="194dp"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/connectButton"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginStart="6dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="95dp"
        android:layout_toStartOf="@+id/checkBoxBufferSize"
        android:layout_toEndOf="@+id/connectButton"
        android:onClick="onDisconnectButtonPressed"
        android:text="@string/disconnect_button_title" />


    <Button
        android:id="@+id/ScanButton"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/connectButton"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:onClick="onScanButtonPressed"
        android:text="@string/send_button_title" />

    <Button
        android:id="@+id/SingleShotReadButton"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ScanButton"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:onClick="onSingleShotReadButtonPressed"
        android:text="SingleShotRead" />

    <Button
        android:id="@+id/btnReadEvent"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/receivedDataScrollView"
        android:layout_below="@+id/btnFlashFirmware"
        android:layout_alignBaseline="@+id/SingleShotReadButton"

        android:layout_toStartOf="@+id/btnContinuousReadEvent"
        android:layout_toEndOf="@+id/SingleShotReadButton"
        android:onClick="onReadEventButtonPressed"
        android:text="Read Event" />

    <Button
        android:id="@+id/btnContinuousReadEvent"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/clearButton"
        android:layout_alignBaseline="@+id/btnReadEvent"
        android:layout_alignParentEnd="true"

        android:layout_marginTop="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginRight="11dp"
        android:onClick="onContinuousReadEventButtonPressed"
        android:text="Continuous ReadEvent" />

    <Button
        android:id="@+id/ContinuousPollButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/SingleShotReadButton"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:onClick="onContinuousPollReadButtonPressed"
        android:text="Continuous Poll" />

    <Button
        android:id="@+id/buttonStopRead"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/receivedDataScrollView"
        android:layout_below="@+id/btnReadEvent"
        android:layout_alignBaseline="@+id/ContinuousPollButton"

        android:layout_marginStart="5dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="93dp"
        android:layout_marginBottom="9dp"
        android:layout_toEndOf="@+id/ContinuousPollButton"
        android:onClick="onStopReadButtonClicked"
        android:text="Stop" />
    <Button
        android:id="@+id/btnGetAttributes"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnContinuousReadEvent"
        android:layout_alignBaseline="@+id/buttonStopRead"
        android:layout_alignParentEnd="true"

        android:layout_marginTop="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginRight="11dp"
        android:onClick="onGetAttributesButtonPressed"
        android:text="GetAttributes" />
    <Button
        android:id="@+id/clearButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/checkBoxBufferSize"
        android:layout_alignBaseline="@+id/ScanButton"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginRight="11dp"
        android:onClick="onClearButtonPressed"
        android:text="@string/clear_button_title" />

    <Button
        android:id="@+id/btnFlashFirmware"
        android:layout_width="197dp"
        android:layout_height="wrap_content"
        android:layout_above="@+id/receivedDataScrollView"
        android:layout_below="@+id/disconnectButton"
        android:layout_alignBaseline="@+id/ScanButton"
        android:layout_alignParentRight="true"
        android:layout_marginStart="5dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="70dp"
        android:layout_marginBottom="9dp"
        android:layout_toStartOf="@+id/clearButton"
        android:layout_toEndOf="@+id/ScanButton"
        android:onClick="onFlashFirmwareButtonPressed"
        android:text="@string/flash_button_title" />

    <TextView
        android:id="@+id/receivedDataLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ContinuousPollButton"
        android:layout_alignLeft="@+id/mainTitle"
        android:layout_marginTop="6dp"
        android:labelFor="@+id/receivedDataTextView"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <ScrollView
        android:id="@+id/receivedDataScrollView"
        android:layout_width="410dp"
        android:layout_height="567dp"
        android:layout_below="@+id/receivedDataLabel"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="-17dp"
        android:layout_marginRight="0dp"
        android:layout_marginBottom="5dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/receivedDataTextView"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#6A7C91"
            android:gravity="top"
            android:text="@string/data_to_send_placeholder"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="#FFFFFF" />
    </ScrollView>

    <CheckBox
        android:id="@+id/checkBoxBufferSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="8dp"
        android:text="128K" />

</RelativeLayout>

